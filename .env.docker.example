# Env for Docker containers (DATABASE_URL uses "db" hostname)
DATABASE_URL=postgresql://user:password@db:5432/db_name

# Long random string used to sign session cookies
SESSION_SECRET=change-me

PORT=8000

# Postgres container settings (must be consistent with DATABASE_URL above)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db_name

# Optional: seed passwords (used by: `npm run seed`)
# Keep these commented in templates; set real values only in your `.env.docker`.
# SEED_ADMIN_PASSWORD=Pass123
# SEED_CUSTOMER_PASSWORD=Pass123
