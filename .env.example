# Env for local development (DATABASE_URL uses localhost)
# Required by the app (Express session store + Prisma)
DATABASE_URL=postgres://user:password@localhost:5432/db_name

# Optional: server port (default: 3000)
PORT=3000

# Long random string used to sign session cookies
SESSION_SECRET=change-me

# Optional: seed passwords (used by: `npm run seed`)
# Keep these commented in templates; set real values only in your local `.env`.
# SEED_ADMIN_PASSWORD=Pass123
# SEED_CUSTOMER_PASSWORD=Pass123
