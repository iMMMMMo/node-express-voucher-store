generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement()) @map("user_id")
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      String 
  createdAt DateTime @default(now())

  addresses   UserAddress[]
  orders      Order[]
  pages       Page[]
  banners     Banner[]
  settings    Settings[]
  navigations Navigation[]

  @@map("users")
}

model UserAddress {
  id         Int      @id @default(autoincrement()) @map("address_id")
  userId     Int      @map("user_id")
  street     String
  city       String
  postalCode String
  country    String
  type       String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("useraddress")
}

model Navigation {
  id        Int      @id @default(autoincrement()) @map("nav_id")
  userId    Int?     @map("user_id")
  parentId  Int?     @map("parent_id")
  title     String
  url       String
  order     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user     User?        @relation(fields: [userId], references: [id])
  parent   Navigation? @relation("NavTree", fields: [parentId], references: [id])
  children Navigation[] @relation("NavTree")

  @@map("navigation")
}

model Page {
  id        Int      @id @default(autoincrement()) @map("page_id")
  userId    Int      @map("user_id")
  title     String
  url       String   @unique
  content   String?
  imagePath String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("page")
}

model Settings {
  id     Int     @id @default(autoincrement()) @map("settings_id")
  userId Int     @map("user_id")
  name   String
  value  String?

  user User @relation(fields: [userId], references: [id])

  @@map("settings")
}

model Banner {
  id        Int      @id @default(autoincrement()) @map("banner_id")
  userId    Int      @map("user_id")
  imagePath String?
  caption   String?
  content   String?
  button    String?
  link      String?
  order     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("banner")
}

model Order {
  id             Int      @id @default(autoincrement()) @map("order_id")
  userId         Int      @map("user_id")
  totalPrice     Decimal  @db.Decimal(10, 2)
  status         String
  paymentMethod  String?
  paymentPrice   Decimal? @db.Decimal(10, 2)
  paymentStatus  String?
  deliveryMethod String?
  deliveryPrice  Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@map("order")
}

model OrderItem {
  id                 Int      @id @default(autoincrement()) @map("order_item_id")
  orderId            Int      @map("order_id")
  productId          Int      @map("product_id")
  recipientName      String?
  dedication         String?
  quantity           Int
  unitPrice          Decimal  @db.Decimal(10, 2)
  vat                Decimal? @map("VAT") @db.Decimal(4, 2)
  finalPrice         Decimal  @db.Decimal(10, 2)
  selectedAttributes Json?
  status             String?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("orderitem")
}

model Product {
  id          Int      @id @default(autoincrement()) @map("product_id")
  name        String
  slug        String   @unique
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)
  vat         Decimal  @map("VAT") @db.Decimal(4, 2)
  imagePath   String?
  createdAt   DateTime @default(now())

  attributes ProductAttributeValue[]
  orderItems OrderItem[]

  @@map("product")
}

model ProductAttribute {
  id   Int    @id @default(autoincrement()) @map("attribute_id")
  name String

  values ProductAttributeValue[]

  @@map("productattribute")
}

model ProductAttributeValue {
  id          Int    @id @default(autoincrement()) @map("value_id")
  productId   Int    @map("product_id")
  attributeId Int    @map("attribute_id")
  value       String
  priceDelta  Decimal @default(0) @map("price_delta") @db.Decimal(10, 2)

  product   Product          @relation(fields: [productId], references: [id])
  attribute ProductAttribute @relation(fields: [attributeId], references: [id])

  @@map("productattributevalue")
}
