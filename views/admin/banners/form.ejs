<%
  const mode = (viewData && viewData.mode) ? viewData.mode : 'create';
  const banner = (viewData && viewData.banner) ? viewData.banner : null;
  const errors = (viewData && viewData.errors) ? viewData.errors : null;
  const availableImages = (viewData && viewData.availableImages) ? viewData.availableImages : [];
  const formData = (viewData && viewData.formData) ? viewData.formData : {};

  const isEdit = mode === 'edit';
  const action = isEdit && banner && banner.id ? `/admin/banners/${banner.id}` : '/admin/banners';
  const heading = isEdit ? 'Edit banner' : 'New banner';

  const checked = (value) => (value ? 'checked' : '');

  const getPathBaseName = (p) => {
    const str = (p ?? '').toString();
    if (!str) return '';
    const parts = str.split('/').filter(Boolean);
    return parts.length ? parts[parts.length - 1] : '';
  };

  const selectedExistingImage = (() => {
    const explicit = String(formData.existingImage ?? '');
    if (explicit) return explicit;
    if (isEdit && banner && banner.imagePath) {
      const base = getPathBaseName(banner.imagePath);
      const exists = availableImages.some((img) => String(img.name) === String(base));
      return exists ? base : '';
    }
    return '';
  })();
%>

<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-6">
        <h3 class="mb-0"><%= heading %></h3>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-end">
          <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
          <li class="breadcrumb-item"><a href="/admin/banners">Banners</a></li>
          <li class="breadcrumb-item active" aria-current="page"><%= heading %></li>
        </ol>
      </div>
    </div>
  </div>
</div>

<div class="app-content">
  <div class="container-fluid">
    <% if (errors && errors.length) { %>
      <div class="alert alert-danger" role="alert">
        <ul class="mb-0">
          <% errors.forEach((e) => { %>
            <li><%= e.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= heading %></h3>
      </div>

      <form method="post" action="<%= action %>" enctype="multipart/form-data">
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label" for="caption">Caption</label>
            <input type="text" id="caption" name="caption" class="form-control" value="<%= (formData.caption ?? '') %>" maxlength="200" />
          </div>

          <div class="mb-3">
            <label class="form-label" for="content">Content</label>
            <textarea id="content" name="content" class="form-control" rows="5" maxlength="5000"><%= (formData.content ?? '') %></textarea>
            <div class="form-text">Optional. Short description for the banner.</div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label" for="button">Button text</label>
              <input type="text" id="button" name="button" class="form-control" value="<%= (formData.button ?? '') %>" maxlength="80" />
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label" for="link">Link</label>
              <input type="text" id="link" name="link" class="form-control" value="<%= (formData.link ?? '') %>" maxlength="300" placeholder="/shop or https://..." />
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label" for="order">Order</label>
              <input type="number" id="order" name="order" class="form-control" value="<%= (formData.order ?? '0') %>" />
              <div class="form-text">Lower order shows first.</div>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Active</label>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="isActive" id="isActive" <%= checked(formData.isActive) %> />
                <label class="form-check-label" for="isActive">Enabled</label>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="image">Image</label>
            <input class="form-control" type="file" id="image" name="image" accept="image/*" />

            <div class="form-text">Or select an already uploaded image:</div>

            <div class="mt-2">
              <% if (!availableImages.length) { %>
                <div class="text-muted">No uploaded images found in <code>public/images/banners</code>.</div>
              <% } else { %>
                <div class="row g-2">
                  <div class="col-12 col-md-6 col-lg-4">
                    <label class="w-100">
                      <input
                        class="form-check-input visually-hidden"
                        type="radio"
                        name="existingImage"
                        id="existingImage_none"
                        value=""
                        <%= (String(selectedExistingImage) === '') ? 'checked' : '' %>
                      />

                      <div class="image-tile border rounded p-2" data-image-tile>
                        <div
                          class="image-tile-placeholder border rounded w-100 d-flex align-items-center justify-content-center text-muted"
                          style="aspect-ratio: 3 / 1;"
                        >
                          No image
                        </div>
                      </div>
                    </label>
                  </div>

                  <% availableImages.forEach((img) => { %>
                    <div class="col-12 col-md-6 col-lg-4">
                      <label class="w-100">
                        <input
                          class="form-check-input visually-hidden"
                          type="radio"
                          name="existingImage"
                          id="existingImage_<%= img.name.replace(/[^a-zA-Z0-9_-]/g, '_') %>"
                          value="<%= img.name %>"
                          <%= (String(selectedExistingImage) === String(img.name)) ? 'checked' : '' %>
                        />

                        <div class="image-tile border rounded p-2" data-image-tile>
                          <img
                            src="<%= img.webPath %>"
                            alt="Selected image"
                            class="img-thumbnail w-100"
                            style="object-fit: cover; aspect-ratio: 3 / 1;"
                          />
                        </div>
                      </label>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>

            <% if (isEdit && banner && banner.imagePath) { %>
              <div class="form-text">
                Current: <a href="<%= banner.imagePath %>" target="_blank" rel="noopener noreferrer"><%= banner.imagePath %></a>
              </div>
            <% } %>
          </div>
        </div>

        <div class="card-footer d-flex gap-2">
          <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save changes' : 'Create banner' %></button>
          <a href="/admin/banners" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  .image-tile {
    cursor: pointer;
    user-select: none;
  }
</style>

<script>
  (function () {
    const inputs = document.querySelectorAll('input[name="existingImage"]');
    if (!inputs.length) return;

    const updateTiles = () => {
      inputs.forEach((input) => {
        const label = input.closest('label');
        const tile = label ? label.querySelector('[data-image-tile]') : null;
        if (!tile) return;

        if (input.checked) {
          tile.classList.add('border-primary', 'border-2', 'bg-body-tertiary');
        } else {
          tile.classList.remove('border-primary', 'border-2', 'bg-body-tertiary');
        }
      });
    };

    inputs.forEach((input) => input.addEventListener('change', updateTiles));
    updateTiles();
  })();
</script>
