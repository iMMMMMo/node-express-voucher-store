<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title || 'Admin' %></title>

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/adminlte/css/adminlte.css" />
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <nav class="app-header navbar navbar-expand bg-body">
        <div class="container-fluid">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                <i class="bi bi-list"></i>
              </a>
            </li>
            <li class="nav-item d-none d-md-block">
              <a href="/" class="nav-link">Shop</a>
            </li>
          </ul>

          <ul class="navbar-nav ms-auto">
            <li class="nav-item dropdown user-menu">
              <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                <i class="bi bi-person-circle me-1"></i>
                <span class="d-none d-md-inline"><%= userName || 'Admin' %></span>
              </a>
              <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                <li class="user-header text-bg-primary">
                  <p>
                    <%= userName || 'Admin' %>
                    <% if (userEmail) { %>
                      <small><%= userEmail %></small>
                    <% } %>
                  </p>
                </li>
                <li class="user-footer">
                  <a href="/account" class="btn btn-outline-secondary">Profile</a>
                  <form action="/logout" method="post" class="float-end m-0">
                    <button type="submit" class="btn btn-outline-danger">Sign out</button>
                  </form>
                </li>
              </ul>
            </li>
          </ul>
        </div>
      </nav>

      <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
        <div class="sidebar-brand">
          <a href="/admin" class="brand-link">
            <span class="brand-text fw-light">Shop Admin</span>
          </a>
        </div>
        <div class="sidebar-wrapper">
          <nav class="mt-2">
            <ul
              class="nav sidebar-menu flex-column"
              data-lte-toggle="treeview"
              role="navigation"
              aria-label="Main navigation"
              data-accordion="false"
            >
              <li class="nav-header">SHOP ADMIN</li>
              <li class="nav-item">
                <a href="/admin" class="nav-link">
                  <i class="nav-icon bi bi-speedometer"></i>
                  <p>Dashboard</p>
                </a>
              </li>
              <li class="nav-item">
                <a href="/admin/orders" class="nav-link">
                  <i class="nav-icon bi bi-receipt"></i>
                  <p>Orders</p>
                </a>
              </li>
              <li class="nav-item">
                <a href="/admin/products" class="nav-link">
                  <i class="nav-icon bi bi-bag"></i>
                  <p>Products</p>
                </a>
              </li>
              <li class="nav-item">
                <a href="/admin/attributes" class="nav-link">
                  <i class="nav-icon bi bi-list-check"></i>
                  <p>Attributes</p>
                </a>
              </li>
              <li class="nav-item">
                <a href="/admin/banners" class="nav-link">
                  <i class="nav-icon bi bi-image"></i>
                  <p>Banners</p>
                </a>
              </li>
              <li class="nav-item">
                <a href="/admin/pages" class="nav-link">
                  <i class="nav-icon bi bi-file-earmark-text"></i>
                  <p>Pages</p>
                </a>
              </li>
              <li class="nav-item">
                <a href="/admin/navigations" class="nav-link">
                  <i class="nav-icon bi bi-list"></i>
                  <p>Navigations</p>
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </aside>

      <main class="app-main">
        <%- include(viewFile) %>
      </main>

      <footer class="app-footer">
        <strong>Shop Admin</strong>
      </footer>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.min.js"
      crossorigin="anonymous"
    ></script>
    <script src="/adminlte/js/adminlte.js"></script>
  </body>
</html>
