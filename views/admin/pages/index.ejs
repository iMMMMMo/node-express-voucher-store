<%
  const pages = (viewData && viewData.pages) ? viewData.pages : [];
  const stripHtml = (value) => (value ?? '').toString().replace(/<[^>]*>/g, ' ');
  const decodeHtmlEntities = (value) => {
    const text = (value ?? '').toString();
    return text
      .replace(/&nbsp;/gi, ' ')
      .replace(/&#160;/g, ' ')
      .replace(/&amp;/gi, '&')
      .replace(/&lt;/gi, '<')
      .replace(/&gt;/gi, '>')
      .replace(/&quot;/gi, '"')
      .replace(/&#39;/g, "'")
      .replace(/&#x27;/gi, "'");
  };
  const cleanPreviewText = (value) => {
    const stripped = stripHtml(value);
    const decoded = decodeHtmlEntities(stripped).replace(/\u00A0/g, ' ');
    return decoded.replace(/\s+/g, ' ').trim();
  };
  const truncate = (value, maxLen = 140) => {
    const text = (value ?? '').toString().replace(/\s+/g, ' ').trim();
    if (!text) return '';
    if (text.length <= maxLen) return text;
    return text.slice(0, Math.max(0, maxLen - 1)) + '…';
  };
%>

<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-6">
        <h3 class="mb-0">Pages</h3>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-end">
          <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
          <li class="breadcrumb-item active" aria-current="page">Pages</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<div class="app-content">
  <div class="container-fluid">
    <% if (viewData && viewData.error) { %>
      <div class="alert alert-danger" role="alert"><%= viewData.error %></div>
    <% } %>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Pages list</h3>
        <div class="card-tools">
          <a href="/admin/pages/new" class="btn btn-primary btn-sm">New page</a>
        </div>
      </div>

      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-striped mb-0">
            <thead>
              <tr>
                <th style="width: 80px;">ID</th>
                <th>Title</th>
                <th>URL</th>
                <th>Content</th>
                <th style="width: 160px;">Current Image</th>
                <th style="width: 180px;">Created</th>
                <th style="width: 140px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!pages.length) { %>
                <tr>
                  <td colspan="7" class="text-center text-muted py-4">No pages found.</td>
                </tr>
              <% } %>

              <% pages.forEach((page) => { %>
                <tr>
                  <td><%= page.id %></td>
                  <td><%= page.title %></td>
                  <td>
                    <a href="/p/<%= page.url %>" target="_blank" rel="noopener noreferrer">/p/<%= page.url %></a>
                  </td>
                  <td><%= truncate(cleanPreviewText(page.content)) %></td>
                  <td>
                    <% if (page.imagePath) { %>
                      <a href="<%= page.imagePath %>" target="_blank" rel="noopener noreferrer" title="Open full image">
                        <img
                          src="<%= page.imagePath %>"
                          alt="<%= page.title %>"
                          class="img-thumbnail"
                          style="width: 96px; height: 96px; object-fit: cover;"
                        />
                      </a>
                    <% } else { %>
                      <span class="text-muted">—</span>
                    <% } %>
                  </td>
                  <td><%= page.createdAt ? new Date(page.createdAt).toLocaleString() : '' %></td>
                  <td>
                    <div class="btn-group" role="group" aria-label="Page actions">
                      <a href="/admin/pages/<%= page.id %>/edit" class="btn btn-outline-primary btn-sm">Edit</a>
                      <form method="post" action="/admin/pages/<%= page.id %>/delete" style="display: inline;" onsubmit="return confirm('Delete this page?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
