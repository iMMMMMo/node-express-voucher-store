<% const product = viewData && viewData.product ? viewData.product : null; %>

<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-6">
        <h3 class="mb-0">Attribute pricing</h3>
        <% if (product) { %>
          <div class="text-muted">Product: <strong><%= product.name %></strong> (<%= product.slug %>)</div>
        <% } %>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-end">
          <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
          <li class="breadcrumb-item"><a href="/admin/products">Products</a></li>
          <li class="breadcrumb-item active" aria-current="page">Attribute pricing</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<div class="app-content">
  <div class="container-fluid">
    <% if (viewData && viewData.saved) { %>
      <div class="alert alert-success" role="alert">Saved.</div>
    <% } %>

    <% if (!product) { %>
      <div class="alert alert-warning" role="alert">Product not found.</div>
      <a class="btn btn-outline-primary" href="/admin/products">Back</a>
    <% } else { %>
      <form method="post" action="/admin/products/<%= product.id %>/attributes">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Price deltas (GROSS, VAT-included)</h3>
          </div>

          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-striped mb-0">
                <thead>
                  <tr>
                    <th style="width: 260px;">Attribute</th>
                    <th>Value</th>
                    <th style="width: 200px;">Price delta (GROSS)</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!product.attributes || !product.attributes.length) { %>
                    <tr>
                      <td colspan="3" class="text-center text-muted py-4">No attributes assigned to this product.</td>
                    </tr>
                  <% } %>

                  <% (product.attributes || []).forEach((row) => { %>
                    <tr>
                      <td><%= row.attribute ? row.attribute.name : '' %></td>
                      <td><%= row.value %></td>
                      <td>
                        <input
                          type="number"
                          class="form-control"
                          name="priceDelta_<%= row.id %>"
                          step="0.01"
                          value="<%= row.priceDelta ? row.priceDelta.toString() : '0.00' %>"
                        />
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-outline-secondary" href="/admin/products">Back</a>
          </div>
        </div>
      </form>
    <% } %>
  </div>
</div>
