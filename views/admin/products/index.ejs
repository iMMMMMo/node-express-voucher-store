<%
  const products = (viewData && viewData.products) ? viewData.products : [];
  const truncate = (value, maxLen = 140) => {
    const text = (value ?? '').toString().replace(/\s+/g, ' ').trim();
    if (!text) return '';
    if (text.length <= maxLen) return text;
    return text.slice(0, Math.max(0, maxLen - 1)) + '…';
  };
%>

<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-6">
        <h3 class="mb-0">Products</h3>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-end">
          <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
          <li class="breadcrumb-item active" aria-current="page">Products</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<div class="app-content">
  <div class="container-fluid">
    <% if (viewData && viewData.error) { %>
      <div class="alert alert-danger" role="alert"><%= viewData.error %></div>
    <% } %>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Products list</h3>
        <div class="card-tools">
          <a href="/admin/products/new" class="btn btn-primary btn-sm">New product</a>
        </div>
      </div>

      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-striped mb-0">
            <thead>
              <tr>
                <th style="width: 80px;">ID</th>
                <th>Name</th>
                <th>Slug</th>
                <th>Description</th>
                <th style="width: 180px;">Current Image</th>
                <th style="width: 140px;">Base price</th>
                <th style="width: 100px;">VAT</th>
                <th style="width: 160px;">Final price</th>
                <th style="width: 180px;">Created</th>
                <th style="width: 180px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!products.length) { %>
                <tr>
                  <td colspan="11" class="text-center text-muted py-4">No products found.</td>
                </tr>
              <% } %>

              <% products.forEach((product) => { %>
                <tr>
                  <td><%= product.id %></td>
                  <td><%= product.name %></td>
                  <td>
                    <a href="/shop/<%= product.slug %>" target="_blank" rel="noopener noreferrer"><%= product.slug %></a>
                  </td>
                  <td><%= truncate(product.description) %></td>
                  <td>
                    <% if (product.imagePath) { %>
                      <a href="<%= product.imagePath %>" target="_blank" rel="noopener noreferrer" title="Open full image">
                        <img
                          src="<%= product.imagePath %>"
                          alt="<%= product.name %>"
                          class="img-thumbnail"
                          style="width: 96px; height: 96px; object-fit: cover;"
                        />
                      </a>
                    <% } else { %>
                      <span class="text-muted">—</span>
                    <% } %>
                  </td>
                  <td><%= (typeof product.basePrice === 'number') ? product.basePrice.toFixed(2) : '' %></td>
                  <td><%= (typeof product.vat === 'number') ? product.vat.toFixed(2) + '%' : '' %></td>
                  <td><%= (typeof product.finalPrice === 'number') ? product.finalPrice.toFixed(2) : '' %></td>
                  <td><%= product.createdAt ? new Date(product.createdAt).toLocaleString() : '' %></td>
                  <td>
                    <div class="btn-group" role="group" aria-label="Product actions">
                      <a href="/admin/products/<%= product.id %>/edit" class="btn btn-outline-primary btn-sm">Edit</a>
                      <a href="/admin/products/<%= product.id %>/attributes" class="btn btn-outline-primary btn-sm text-nowrap">Manage attributes</a>
                      <form method="post" action="/admin/products/<%= product.id %>/delete" style="display: inline;" onsubmit="return confirm('Delete this product?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
