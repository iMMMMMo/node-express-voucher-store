<%- include('partials/head', { title: 'Cart | Voucher Shop' }) %>
<body>
  
  <div class="site-wrap">
    <%- include('partials/header', { activePage: 'cart' }) %>

    <div class="bg-light py-3">
      <div class="container">
        <div class="row">
          <div class="col-md-12 mb-0"><a href="/">Home</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">Cart</strong></div>
        </div>
      </div>
    </div>

    <div class="site-section">
      <div class="container">
        <% if (notice) { %>
          <div class="row mb-4">
            <div class="col-md-12">
              <div class="border p-4 rounded" role="alert">
                <strong class="text-black">Info:</strong> <%= notice %>
              </div>
            </div>
          </div>
        <% } %>

        <div class="row mb-5">
          <div class="col-md-12">
            <div class="site-blocks-table">
              <table class="table table-bordered">
                <thead>
                  <tr>
                    <th class="product-thumbnail">Image</th>
                    <th class="product-name">Product</th>
                    <th class="product-price">Price</th>
                    <th class="product-quantity">Quantity</th>
                    <th class="product-total">Total</th>
                    <th class="product-remove">Remove</th>
                  </tr>
                </thead>
                <tbody id="cart-items">
                  <% if (cart && cart.length > 0) { %>
                    <% cart.forEach((item) => { %>
                      <tr data-key="<%= (item.key || item.slug) %>">
                        <td class="product-thumbnail">
                          <img src="<%= item.imagePath || '/images/products/product-default.jpg' %>" alt="<%= item.name %>" class="img-fluid">
                        </td>
                        <td class="product-name">
                          <h2 class="h5 text-black"><%= item.name %></h2>
                          <% if (item.selectedAttributes && item.selectedAttributes.length) { %>
                            <% item.selectedAttributes.forEach((a) => { %>
                              <small class="text-muted d-block">
                                <%= a.attributeName || '' %>: <%= a.value %>
                                <% if (typeof a.priceDelta === 'number' && a.priceDelta) { %>
                                  (<%= a.priceDelta >= 0 ? '+' : '' %><%= a.priceDelta.toFixed(2) %> PLN)
                                <% } %>
                              </small>
                            <% }) %>
                          <% } %>

                          <div class="mt-2">
                            <% 
                              const qty = Number.parseInt(item.quantity, 10) || 1;
                              const recipientsArr = Array.isArray(item.recipients) ? item.recipients : [];
                              const legacyRecipient = (item.recipientName || item.dedication)
                                ? { recipientName: item.recipientName || '', dedication: item.dedication || '' }
                                : null;
                              const effectiveRecipients = recipientsArr.length ? recipientsArr : (legacyRecipient ? [legacyRecipient] : []);
                            %>

                            <button
                              type="button"
                              class="btn btn-outline-primary btn-sm js-toggle-dedications"
                              data-key="<%= (item.key || item.slug) %>"
                            >
                              Dedykacje
                            </button>

                            <div class="mt-3 js-dedications" data-key="<%= (item.key || item.slug) %>" style="display:none;">
                              <div class="row">
                                <% for (let i = 0; i < qty; i++) { 
                                  const r = effectiveRecipients[i] || { recipientName: '', dedication: '' };
                                %>
                                  <div class="col-12 col-md-6 mb-3">
                                    <div class="border p-3">
                                      <div class="mb-2"><strong>Voucher <%= i + 1 %></strong></div>
                                      <div class="form-group">
                                        <label class="text-muted" style="font-size: 12px;">Recipient name (optional)</label>
                                        <input
                                          type="text"
                                          class="form-control form-control-sm js-recipient-name"
                                          data-key="<%= (item.key || item.slug) %>"
                                          data-index="<%= i %>"
                                          maxlength="60"
                                          value="<%= r.recipientName || '' %>"
                                          placeholder="e.g. Ania"
                                        />
                                      </div>
                                      <div class="form-group mb-0">
                                        <label class="text-muted" style="font-size: 12px;">Dedication (optional)</label>
                                        <textarea
                                          class="form-control form-control-sm js-dedication"
                                          data-key="<%= (item.key || item.slug) %>"
                                          data-index="<%= i %>"
                                          maxlength="1000"
                                          rows="2"
                                          placeholder="Short message / wishes"
                                        ><%= r.dedication || '' %></textarea>
                                      </div>
                                    </div>
                                  </div>
                                <% } %>
                              </div>
                            </div>
                          </div>
                        </td>
                        <td><%= (Number(item.price) || 0).toFixed(2) %> PLN</td>
                        <td>
                          <div class="input-group mb-3 m-auto" style="max-width: 120px;">
                            <div class="input-group-prepend">
                              <button class="btn btn-outline-primary js-cart-minus" type="button" data-key="<%= (item.key || item.slug) %>">&minus;</button>
                            </div>
                            <input type="text" class="form-control text-center js-cart-quantity" value="<%= item.quantity %>" data-key="<%= (item.key || item.slug) %>" readonly>
                            <div class="input-group-append">
                              <button class="btn btn-outline-primary js-cart-plus" type="button" data-key="<%= (item.key || item.slug) %>">&plus;</button>
                            </div>
                          </div>
                        </td>
                        <td class="js-item-total"><%= ((Number(item.price) || 0) * (Number(item.quantity) || 0)).toFixed(2) %> PLN</td>
                        <td><button class="btn btn-primary btn-sm js-cart-remove" data-key="<%= (item.key || item.slug) %>">X</button></td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="6" class="text-center py-5">
                        <p>Your cart is empty.</p>
                        <a href="/shop" class="btn btn-primary">Continue Shopping</a>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6">
            <div class="row mb-5">
              <div class="col-md-6 mb-3 mb-md-0">
                <button class="btn btn-primary btn-sm btn-block" onclick="window.location.reload()">Update Cart</button>
              </div>
              <div class="col-md-6">
                <button class="btn btn-outline-primary btn-sm btn-block" onclick="window.location='/shop'">Continue Shopping</button>
              </div>
            </div>
          </div>
          <div class="col-md-6 pl-5">
            <div class="row justify-content-end">
              <div class="col-md-7">
                <div class="row">
                  <div class="col-md-12 text-right border-bottom mb-5">
                    <h3 class="text-black h4 text-uppercase">Summary</h3>
                  </div>
                </div>
                <div class="row mb-5">
                  <div class="col-md-6">
                    <span class="text-black">Total</span>
                  </div>
                  <div class="col-md-6 text-right">
                    <strong class="text-black js-total"><%= total ? total.toFixed(2) : '0.00' %> PLN</strong>
                  </div>
                </div>

                <% if (cart && cart.length > 0) { %>
                  <div class="row">
                    <div class="col-md-12">
                      <button class="btn btn-primary btn-lg py-3 btn-block" onclick="window.location='/checkout'">Proceed to Checkout</button>
                    </div>
                  </div>
                <% } else { %>
                  <div class="row">
                    <div class="col-md-12">
                      <button class="btn btn-primary btn-lg py-3 btn-block" disabled>Proceed to Checkout</button>
                      <small class="text-muted d-block mt-2">Add at least one item to your cart to continue.</small>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%- include('partials/footer') %>
  </div>

<%- include('partials/scripts') %>