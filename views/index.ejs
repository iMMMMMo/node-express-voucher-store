<%- include('partials/head', { title: 'Home | Voucher Store' }) %>
<body>
  <div class="site-wrap">
    <%- include('partials/header', { activePage: 'home' }) %>

    <% const homeBanners = (typeof banners !== 'undefined' && Array.isArray(banners)) ? banners : []; %>

    <% if (homeBanners.length) { %>
      <div class="hero-slide owl-carousel">
        <% homeBanners.forEach((b) => { %>
          <div
            class="site-blocks-cover"
            style="background-image: url('/images/banners/banner-default.jpg');"
            data-bg="<%= b.imagePath || '/images/banners/banner-default.jpg' %>"
            data-aos="fade"
          >
            <div class="container">
              <div class="row align-items-start align-items-md-center justify-content-end">
                <div class="col-md-5 text-center text-md-left pt-5 pt-md-0">
                  <h1 class="mb-2"><%= b.caption || 'Digital Gift Vouchers, Instantly' %></h1>
                  <div class="intro-text text-center text-md-left">
                    <p class="mb-4"><%= b.content || 'Choose a voucher, pay securely, and receive the code in seconds.' %></p>
                    <p>
                      <% if (b.button && b.link) { %>
                        <a href="<%= b.link %>" class="btn btn-sm btn-primary"><%= b.button %></a>
                      <% } else { %>
                        <a href="/shop" class="btn btn-sm btn-primary">Browse Vouchers</a>
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="site-blocks-cover" style="background-image: url('/images/banners/banner-default.jpg');" data-aos="fade">
        <div class="container">
          <div class="row align-items-start align-items-md-center justify-content-end">
            <div class="col-md-5 text-center text-md-left pt-5 pt-md-0">
              <h1 class="mb-2">Digital Gift Vouchers, Instantly</h1>
              <div class="intro-text text-center text-md-left">
                <p class="mb-4">Choose a voucher, pay securely, and receive the code in seconds. Perfect for birthdays, holidays, or a last‑minute gift.</p>
                <p>
                  <a href="/shop" class="btn btn-sm btn-primary">Browse Vouchers</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <div class="site-section site-section-sm site-blocks-1">
      <div class="container">
        <div class="row">
          <div class="col-md-6 col-lg-4 d-lg-flex mb-4 mb-lg-0 pl-4" data-aos="fade-up" data-aos-delay="">
            <div class="icon mr-4 align-self-start">
              <span class="icon-paper-plane"></span>
            </div>
            <div class="text">
              <h2 class="text-uppercase">Instant Delivery</h2>
              <p>Receive your voucher code immediately after payment, ready to print or send by email.</p>
            </div>
          </div>
          <div class="col-md-6 col-lg-4 d-lg-flex mb-4 mb-lg-0 pl-4" data-aos="fade-up" data-aos-delay="100">
            <div class="icon mr-4 align-self-start">
              <span class="icon-lock"></span>
            </div>
            <div class="text">
              <h2 class="text-uppercase">Secure Checkout</h2>
              <p>Safe payments and reliable order processing for every voucher purchase.</p>
            </div>
          </div>
          <div class="col-md-6 col-lg-4 d-lg-flex mb-4 mb-lg-0 pl-4" data-aos="fade-up" data-aos-delay="200">
            <div class="icon mr-4 align-self-start">
              <span class="icon-help"></span>
            </div>
            <div class="text">
              <h2 class="text-uppercase">Easy to Redeem</h2>
              <p>Simple redemption rules and clear instructions so the recipient can use the voucher without hassle.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="site-section site-blocks-2">
      <div class="container">
        <div class="row">
          <% const newest = (typeof latestProducts !== 'undefined' && Array.isArray(latestProducts)) ? latestProducts : []; %>
          <% const tiles = newest.slice(0, 3); %>

          <% for (let i = 0; i < 3; i += 1) { %>
            <% const p = tiles[i]; %>
            <% const isPlaceholder = !p; %>
            <% const title = isPlaceholder ? `Voucher ${i + 1}` : (p.name || `Voucher ${i + 1}`); %>
            <% const href = isPlaceholder ? '/shop' : `/shop/${p.slug}`; %>
            <% const img = (!isPlaceholder && p.imagePath) ? p.imagePath : '/images/products/product-default.jpg'; %>
            <% const delay = i * 100; %>

            <div class="col-sm-6 col-md-6 col-lg-4 mb-4 mb-lg-0" data-aos="fade" data-aos-delay="<%= delay %>">
              <a class="block-2-item" href="<%= href %>">
                <figure class="image">
                  <img src="<%= img %>" alt="<%= title %>" class="img-fluid">
                </figure>
                <div class="text">
                  <h3><%= title %></h3>
                </div>
              </a>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="site-section bg-light">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-7 site-section-heading text-center pt-4">
            <h2>How it works</h2>
          </div>
        </div>
        <div class="row">
          <div class="col-md-4" data-aos="fade-up" data-aos-delay="">
            <div class="p-4 bg-white h-100">
              <h3 class="h5 text-black">1) Pick a voucher</h3>
              <p class="mb-0">Browse and choose the voucher that fits the occasion.</p>
            </div>
          </div>
          <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
            <div class="p-4 bg-white h-100">
              <h3 class="h5 text-black">2) Pay securely</h3>
              <p class="mb-0">Complete checkout in a few clicks with secure payment.</p>
            </div>
          </div>
          <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
            <div class="p-4 bg-white h-100">
              <h3 class="h5 text-black">3) Send or print</h3>
              <p class="mb-0">Get your code instantly and share it with the recipient.</p>
            </div>
          </div>
        </div>
        <div class="row mt-4">
          <div class="col-12 text-center">
            <a href="/shop" class="btn btn-primary btn-sm">Explore all vouchers</a>
            <a href="/cart" class="btn btn-outline-primary btn-sm ml-2">View cart</a>
          </div>
        </div>
      </div>
    </div>
    
    <%- include('partials/footer') %>
  </div>
  <%- include('partials/scripts') %>