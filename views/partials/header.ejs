<header class="site-navbar" role="banner">
    <div class="site-navbar-top">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-6 col-md-4 order-2 order-md-1 site-search-icon text-left">
                    <form action="" class="site-block-top-search">
                        <span class="icon icon-search2"></span>
                        <input type="text" class="form-control border-0" placeholder="Search..">
                    </form>
                </div>
                <div class="col-12 mb-3 mb-md-0 col-md-4 order-1 order-md-2 text-center">
                    <div class="site-logo">
                        <a href="/" class="js-logo-clone">Voucher Shop</a>
                    </div>
                </div>
                <div class="col-6 col-md-4 order-3 order-md-3 text-right">
                    <div class="site-top-icons">
                        <ul>
                            <li class="dropdown">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Account">
                                    <span class="icon icon-person"></span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-right">
                                    <% if (typeof userName !== 'undefined' && userName) { %>
                                        <h6 class="dropdown-header">Logged As: <%= userName %></h6>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" href="/account"><span class="icon icon-id-card"></span> Account</a>
                                        <a class="dropdown-item" href="/orders"><span class="icon icon-shopping_cart"></span> Orders</a>
                                        <a class="dropdown-item" href="/addresses"><span class="icon icon-map-marker"></span> Delivery addresses</a>
                                        <% if (typeof userRole !== 'undefined' && userRole === 'admin') { %>
                                            <a class="dropdown-item" href="/admin" target="_blank" rel="noopener noreferrer"><span class="icon icon-gear"></span> Admin panel</a>
                                        <% } %>
                                        <div class="dropdown-divider"></div>
                                        <form action="/logout" method="post" style="display: inline;">
                                            <button type="submit" class="dropdown-item"><span class="icon icon-sign-out"></span> Logout</button>
                                        </form>
                                    <% } else { %>
                                        <h6 class="dropdown-header">Not Logged In</h6>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" href="/login"><span class="icon icon-sign-in"></span> Login</a>
                                        <a class="dropdown-item" href="/register"><span class="icon icon-user-plus"></span> Register</a>
                                    <% } %>
                                </div>
                            </li>
                            <li>
                                <a href="/cart" class="site-cart" title="Cart">
                                    <span class="icon icon-shopping_cart"></span>
                                    <span class="count js-cart-count" style="display: none;">0</span>
                                </a>
                            </li>
                            <li class="d-inline-block d-md-none ml-md-0"><a href="#" class="site-menu-toggle js-menu-toggle"><span class="icon-menu"></span></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <nav class="site-navigation text-right text-md-center" role="navigation">
        <div class="container">
            <ul class="site-menu js-clone-nav d-none d-md-block">
                <li class="has-children <%= activePage === 'home' ? 'active' : '' %>">
                    <a href="/">Home</a>
                    <ul class="dropdown">
                        <li><a href="#">First Menu</a></li>
                    </ul>
                </li>
                <li><a href="/about">About Us</a></li>
                <li class="<%= activePage === 'shop' ? 'active' : '' %>"><a href="/shop">Shop</a></li>
                <li class="<%= activePage === 'contact' ? 'active' : '' %>"><a href="/contact">Contact</a></li>
            </ul>
        </div>
    </nav>
</header>
