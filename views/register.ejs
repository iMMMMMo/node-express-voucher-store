<%- include('partials/head', { title: 'Register | Voucher Store' }) %>
<body>
  
  <div class="site-wrap">
    <%- include('partials/header', { activePage: activePage }) %>

    <div class="bg-light py-3">
      <div class="container">
        <div class="row">
          <div class="col-md-12 mb-0"><a href="/">Home</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">Register</strong></div>
        </div>
      </div>
    </div>  

    <div class="site-section">
      <div class="container">
        <div class="row">
          <div class="col-md-12">
            <h2 class="h3 mb-3 text-black">Create an account</h2>
          </div>
          <div class="col-md-7">
            <form action="/register" method="post">
              <div class="p-3 p-lg-5 border">
                <% if (errors && errors.length > 0) { %>
                  <div class="alert alert-danger">
                    <ul class="mb-0">
                      <% errors.forEach(error => { %>
                        <li><%= error.msg %></li>
                      <% }); %>
                    </ul>
                  </div>
                <% } %>

                <div class="form-group row">
                  <div class="col-md-12">
                    <label for="email" class="text-black">Email <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" id="email" name="email" value="<%= formData.email || '' %>" required>
                  </div>
                </div>

                <div class="form-group row">
                  <div class="col-md-12">
                    <label for="password" class="text-black">Password <span class="text-danger">*</span></label>
                    <input type="password" class="form-control" id="password" name="password" required>
                    <small class="form-text text-muted">Minimum 6 characters</small>
                  </div>
                </div>

                <div class="form-group row">
                  <div class="col-md-12">
                    <label for="name" class="text-black">Full name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="name" name="name" value="<%= formData.name || '' %>" required>
                  </div>
                </div>

                <div class="form-group row">
                  <div class="col-md-12">
                    <label for="phone" class="text-black">Phone number</label>
                    <div class="row">
                      <div class="col-md-4 mb-2 mb-md-0">
                        <label for="phonePrefixDigits" class="sr-only">Prefix</label>
                        <div class="input-group">
                          <div class="input-group-prepend">
                            <span class="input-group-text">+</span>
                          </div>
                          <input
                            type="text"
                            class="form-control"
                            id="phonePrefixDigits"
                            name="phonePrefixDigits"
                            inputmode="numeric"
                            pattern="\d{1,3}"
                            maxlength="3"
                            placeholder="48"
                            value="<%= (formData && formData.phonePrefixDigits) ? formData.phonePrefixDigits : '48' %>">
                        </div>
                      </div>
                      <div class="col-md-8">
                        <label for="phoneNumber" class="sr-only">Phone number</label>
                        <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber" placeholder="123 456 789" value="<%= (formData && formData.phoneNumber) ? formData.phoneNumber : '' %>">
                      </div>
                    </div>
                    <small class="form-text text-muted">Prefix is 1–3 digits (e.g. +48).</small>
                  </div>
                </div>

                <div class="form-group row">
                  <div class="col-lg-12">
                    <input type="submit" class="btn btn-primary btn-lg btn-block" value="Create account">
                  </div>
                </div>

                <div class="form-group row">
                  <div class="col-lg-12 text-center">
                    <p class="mb-0">Already have an account? <a href="/login">Sign in</a></p>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <%- include('partials/footer') %>
  </div>

<%- include('partials/scripts') %>

