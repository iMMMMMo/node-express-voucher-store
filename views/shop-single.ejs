<%- include('partials/head', { title: 'Voucher Details | Voucher Store' }) %>
<body>
  
  <div class="site-wrap">
    <%- include('partials/header', { activePage: 'shop' }) %>

    <div class="bg-light py-3">
      <div class="container">
        <div class="row">
          <div class="col-md-12 mb-0">
            <a href="/">Home</a> <span class="mx-2 mb-0">/</span> 
            <strong class="text-black"><%= product ? product.name : 'Product Not Found' %></strong>
          </div>
        </div>
      </div>
    </div>  

    <div class="site-section">
      <div class="container">
        <% if (product) { %>
          <div class="row">
            <div class="col-md-6">
              <figure class="voucher-detail-image mb-0">
                <img src="<%= product.imagePath || '/images/cloth_1.jpg' %>" alt="<%= product.name %>" class="img-fluid">
              </figure>
            </div>
            <div class="col-md-6">
              <h2 class="text-black"><%= product.name %></h2>
              <% if (product.description) { %>
                <p><%= product.description %></p>
              <% } %>
              <p>
                <strong class="text-primary h4"><span class="js-product-price" data-base-gross="<%= parseFloat(product.finalPrice).toFixed(2) %>"><%= parseFloat(product.finalPrice).toFixed(2) %></span> PLN</strong>
                <% if (product.VAT > 0) { %>
                  <small class="text-muted">(including <%= product.VAT %>% VAT)</small>
                <% } %>
              </p>
              
              <% if (product.attributes && Object.keys(product.attributes).length > 0) { %>
                <% Object.keys(product.attributes).forEach((attrName, attrIndex) => { %>
                  <div class="mb-3">
                    <label class="d-block mb-2"><strong><%= attrName %>:</strong></label>
                    <div class="d-flex flex-wrap">
                      <% product.attributes[attrName].forEach((attrValue, valueIndex) => { %>
                        <label class="d-flex mr-3 mb-2">
                          <span class="d-inline-block mr-2" style="top:-2px; position: relative;">
                            <input type="radio" id="attr-<%= attrIndex %>-<%= valueIndex %>" name="attr-<%= attrName %>" value="<%= attrValue.value_id %>" data-price-delta="<%= (typeof attrValue.priceDelta === 'number' ? attrValue.priceDelta.toFixed(2) : (parseFloat(attrValue.priceDelta || 0).toFixed(2))) %>" <%= valueIndex === 0 ? 'checked' : '' %>>
                          </span>
                          <span class="d-inline-block text-black">
                            <%= attrValue.value %>
                            <% const d = (typeof attrValue.priceDelta === 'number') ? attrValue.priceDelta : parseFloat(attrValue.priceDelta || 0); %>
                            <% if (d && Number.isFinite(d)) { %>
                              <small class="text-muted">(<%= d >= 0 ? '+' : '' %><%= d.toFixed(2) %> PLN)</small>
                            <% } %>
                          </span>
                        </label>
                      <% }); %>
                    </div>
                  </div>
                <% }); %>
              <% } %>

              <div class="mb-5">
                <div class="input-group mb-3" style="max-width: 120px;">
                  <div class="input-group-prepend">
                    <button class="btn btn-outline-primary js-btn-minus" type="button">&minus;</button>
                  </div>
                  <input type="number" class="form-control text-center" value="1" min="1" step="1" inputmode="numeric" aria-label="Quantity" aria-describedby="button-addon1">
                  <div class="input-group-append">
                    <button class="btn btn-outline-primary js-btn-plus" type="button">&plus;</button>
                  </div>
                </div>
              </div>
              <p>
                <button 
                  class="buy-now btn btn-sm btn-primary js-add-to-cart"
                  data-slug="<%= product.slug %>"
                  data-name="<%= product.name %>"
                  data-price="<%= parseFloat(product.finalPrice).toFixed(2) %>"
                  data-image="<%= product.imagePath || '/images/cloth_1.jpg' %>">
                  Add to cart
                </button>
              </p>
            </div>
          </div>
        <% } else { %>
          <div class="row">
            <div class="col-12 text-center">
              <h2>Product Not Found</h2>
              <p>The product you are looking for does not exist.</p>
              <a href="/shop" class="btn btn-primary">Back to Shop</a>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    

    <%- include('partials/footer') %>
  </div>

<%- include('partials/scripts') %>

<script>
  (function () {
    'use strict';

    function toNumber(value) {
      var n = Number.parseFloat(String(value));
      return Number.isFinite(n) ? n : 0;
    }

    function updateDisplayedPrice() {
      var priceEl = document.querySelector('.js-product-price');
      if (!priceEl) return;

      var baseGross = toNumber(priceEl.getAttribute('data-base-gross'));
      var selected = Array.from(document.querySelectorAll('input[type="radio"][name^="attr-"]:checked'));
      var deltaGross = selected.reduce(function (sum, el) {
        return sum + toNumber(el.getAttribute('data-price-delta'));
      }, 0);

      var totalGross = baseGross + deltaGross;
      priceEl.textContent = totalGross.toFixed(2);
    }

    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('input[type="radio"][name^="attr-"]').forEach(function (el) {
        el.addEventListener('change', updateDisplayedPrice);
      });
      updateDisplayedPrice();
    });
  })();
</script>