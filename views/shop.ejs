<%- include('partials/head', { title: 'All Vouchers | Voucher Store' }) %> 
<body>
  
  <div class="site-wrap">
    <%- include('partials/header', { activePage: 'shop' }) %>

    <div class="bg-light py-3">
      <div class="container">
        <div class="row">
          <div class="col-md-12 mb-0"><a href="/">Home</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">Shop</strong></div>
        </div>
      </div>
    </div>

    <div class="site-section">
      <div class="container">

        <div class="row">
          <div class="col-12">
            <h2 class="text-black h5 mb-4">All vouchers</h2>
          </div>
        </div>

        <div class="row">
          <% if (products && products.length > 0) { %>
            <% products.forEach((product) => { %>
              <div class="col-sm-6 col-lg-4 mb-4" data-aos="fade-up">
                <div class="block-4 text-center border" style="height: 100%; display: flex; flex-direction: column;">
                  <figure class="block-4-image" style="flex-shrink: 0;">
                    <a href="/shop/<%= product.slug %>">
                      <img src="<%= product.imagePath || '/images/cloth_1.jpg' %>" alt="<%= product.name %>" class="img-fluid" style="height: 250px; object-fit: cover; width: 100%;">
                    </a>
                  </figure>
                  <div class="block-4-text p-4" style="flex: 1; display: flex; flex-direction: column;">
                    <h3 style="min-height: 3rem;"><a href="/shop/<%= product.slug %>"><%= product.name %></a></h3>
                    <p class="mb-2" style="flex: 1; min-height: 3rem; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;"><%= product.description ? (product.description.length > 80 ? product.description.substring(0, 80) + '...' : product.description) : 'No description' %></p>
                    <p class="text-primary font-weight-bold mt-auto" style="margin-top: auto;"><%= parseFloat(product.finalPrice).toFixed(2) %> PLN</p>
                    <button 
                      class="btn btn-primary btn-sm mt-3 js-add-to-cart"
                      data-slug="<%= product.slug %>"
                      data-name="<%= product.name %>"
                      data-price="<%= parseFloat(product.finalPrice).toFixed(2) %>"
                      data-image="<%= product.imagePath || '/images/cloth_1.jpg' %>">
                      Add to cart
                    </button>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="col-12">
              <p class="text-center">No products available.</p>
            </div>
          <% } %>
        </div>
        
      </div>
    </div>

    <%- include('partials/footer') %>
  </div>

<%- include('partials/scripts') %>